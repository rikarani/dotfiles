// documentation: https://zed.dev/docs/configuring-zed
{
  // Appearance
  "cli_default_open_behavior": "new_window",
  "agent_servers": {},
  "proxy": "",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  // Editor
  "preferred_line_length": 120,
  "buffer_font_family": "Hack Nerd Font",
  "icon_theme": "Catppuccin Mocha",
  "ui_font_size": 20.0,
  "buffer_font_size": 20,
  "theme": {
    "mode": "dark",
    "light": "Caelestia",
    "dark": "Catppuccin Mocha (Blur)",
  },
  "minimap": {
    "show": "always",
  },
  // AI
  "edit_predictions": {
    "provider": "zed",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [
      {
        "provider": "google",
        "model": "gemini-3.5-flash",
        "enable_thinking": true,
        "effort": "high",
      },
      {
        "provider": "google",
        "model": "gemini-3.1-flash-lite",
        "enable_thinking": true,
        "effort": "high",
      },
      {
        "provider": "google",
        "model": "gemini-3-flash-preview",
        "enable_thinking": true,
        "effort": "high",
      },
      {
        "provider": "google",
        "model": "gemini-2.5-flash-lite",
        "enable_thinking": true,
      },
      {
        "provider": "google",
        "model": "gemini-2.5-flash",
        "enable_thinking": true,
      },
      {
        "provider": "zed.dev",
        "model": "claude-sonnet-5",
        "enable_thinking": true,
        "effort": "medium",
      },
    ],
    "default_model": {
      "effort": "medium",
      "provider": "zed.dev",
      "model": "claude-sonnet-5",
      "enable_thinking": true,
    },
    "commit_message_model": {
      "provider": "copilot_chat",
      "model": "",
    },
  },
  // Individual Languages
  "languages": {
    "CSS": {
      "language_servers": ["tailwindcss-intellisense-css", "!vscode-css-language-server", "..."],
    },
    "JSON": {
      "format_on_save": "on",
      "formatter": "prettier",
      "tab_size": 2,
      "hard_tabs": false,
    },
    "JSONC": {
      "formatter": "prettier",
      "format_on_save": "on",
      "tab_size": 2,
      "hard_tabs": false,
    },
    "PHP": {
      "language_servers": ["intelephense", "!phpactor", "!phptools", "!phpantom", "..."],
    },
    "Prisma": {
      "format_on_save": "on",
      "formatter": "language_server",
      "language_servers": ["prisma-language-server"],
    },
    "TypeScript": {
      "formatter": "prettier",
      "format_on_save": "on",
    },
    "TSX": {
      "formatter": "prettier",
      "format_on_save": "on",
    },
  },
  // LSP Configuration
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true,
      },
    },
    "vtsls": {
      "enable_lsp_tasks": true,
      "settings": {
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "never",
          },
        },
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "never",
          },
        },
      },
    },
    "discord_presence": {
      "initialization_options": {
        "state": "ngedit {filename}",
        "details": "projek {workspace}",
        // URL for the large image
        "large_image": "{base_icons_url}/{language:lo}.png", // :lo lowercase the language name
        "large_text": "{language:u}", // :u capitalizes the first letter
        // URL for the small image
        "small_image": "{base_icons_url}/zed.png",
        "small_text": "Zed",

        // Idle settings - when you're inactive
        "idle": {
          "timeout": 300, // Idle timeout in seconds (300 seconds = 5 minutes)

          // Action to take when idle
          // `change_activity` - changes the activity to idle with the following details
          // `clear_activity` - clears the activity (hides it)
          "action": "change_activity",

          "state": "Idling",
          "details": "In Zed",
          "large_image": "{base_icons_url}/zed.png",
          "large_text": "Zed",
          "small_image": "{base_icons_url}/idle.png",
          "small_text": "Idle",
        },

        // Rules to disable presence in specific workspaces
        "rules": {
          "mode": "blacklist", // Can also be "whitelist"
          "paths": ["absolute path"],
        },

        "git_integration": true,

        // Per-language overrides
        "languages": {
          "rust": {
            "state": "Hacking on {filename}",
            "details": "Rustacean at work",
          },
        },
      },
    },
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cva", "cx"],
        "experimental": {
          "classRegex": ["[cls|className]\\s\\:\\=\\s\"([^\"]*)"],
        },
      },
    },
  },
  // MCP
  "context_servers": {
    "heroui_react": {
      "command": "npx",
      "args": ["-y", "@heroui/react-mcp@latest"],
      "env": {},
    },
  },
}
